{
  "name": "larpcal",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/LarpCal/LARPCal#readme",
  "bugs": {
    "url": "https://github.com/LarpCal/LARPCal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LarpCal/LARPCal.git"
  },
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:client": "npm -w client run dev",
    "dev": "concurrently --names server,client -c auto npm:dev:server npm:dev:client",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "npm -w server run test",
    "typecheck": "concurrently --raw npm:typecheck:server npm:typecheck:client",
    "typecheck:server": "tsc --project server/tsconfig.json --noEmit",
    "typecheck:client": "tsc --project client/tsconfig.json --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "concurrently": "^10.0.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "typescript": "^7.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.3"
  },
  "lint-staged": {
    "{server,client}/**/*.{js,cjs,css,ts,tsx,scss,json,md,yml}": "oxfmt",
    "**/*.{js,mjs,ts,tsx}": "oxlint"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/client@5.22.0": true,
    "@parcel/watcher": false,
    "fsevents": false,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
